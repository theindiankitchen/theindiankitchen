---
import BaseLayout from "../layouts/BaseLayout.astro";
import WelcomeGreetings from "../components/WelcomeGreetings.tsx";
import Marquee from "../components/Marquee.astro";
import SignatureDishesCarousel from "../components/SignatureDishesCarousel.tsx";
import MenuPreview from "../components/MenuPreview.tsx";
import InstagramGrid from "../components/InstagramGrid.astro";
import ReviewsCarousel from "../components/ReviewsCarousel.tsx";
import OrderDelivery from "../components/OrderDelivery.tsx";
import Kolam from "../components/Kolam.astro";

// ---------------------------------------------------------------------------
// Delivery storefront links. GOES HERE: replace all three with the real URLs.
// Uber Eats and DoorDash open in a new tab. PICKUP_URL is a placeholder that
// may become a phone number (tel:) or an online ordering link later.
// ---------------------------------------------------------------------------
const UBER_EATS_URL = "#"; // PLACEHOLDER
const DOORDASH_URL = "#"; // PLACEHOLDER
const PICKUP_URL = "#"; // PLACEHOLDER

const title = "The Indian Kitchen, Biryani and Dosa | Toronto";
const description =
  "Authentic Hyderabadi biryani and South Indian dosa in Toronto. Modern Indian comfort food, crafted with tradition.";
---

<BaseLayout title={title} description={description}>
  {/* HERO: light parchment base with an Indian-monument silhouette band and the
      typewriter welcome. No dark restaurant photo. Uses the sticky reveal. */}
  <section slot="hero" class="reveal-hero flex items-center justify-center text-center">
    {/* Light parchment base (also the fallback colour if the silhouette is absent). */}
    <div aria-hidden="true" class="absolute inset-0 bg-cream-pattern"></div>

    {/* MONUMENT SILHOUETTE SVG GOES HERE: user will supply a clean Indian-monuments
        skyline vector. Placeholder wired here, anchored bottom-center, full width,
        responsive. The cream base above is the fallback so the hero is never blank. */}
    <img
      src="/monuments-silhouette.svg"
      alt=""
      aria-hidden="true"
      class="pointer-events-none select-none absolute inset-x-0 bottom-0 w-full opacity-90"
    />
    {/* Soft cream scrim so text stays legible where it overlaps the silhouette. */}
    <div aria-hidden="true" class="absolute inset-x-0 bottom-0 h-2/5 bg-gradient-to-t from-transparent via-[#e1c7ae]/35 to-transparent"></div>

    {/* Kolam corner flourishes framing the wordmark, faint texture. */}
    <div aria-hidden="true" class="pointer-events-none absolute top-24 left-4 md:left-8">
      <Kolam color="var(--saffron)" size="clamp(70px, 9vw, 128px)" opacity={0.13} />
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute top-24 right-4 md:right-8">
      <Kolam color="var(--saffron)" size="clamp(70px, 9vw, 128px)" opacity={0.13} />
    </div>

    <div class="container-x relative z-10 flex flex-col items-center pt-24 pb-16">
      <div class="flex flex-col items-center text-olive select-none w-full max-w-[92vw] md:max-w-[70vw]">
        <span class="font-serif text-sm sm:text-base md:text-lg tracking-[0.35em] uppercase mb-1 md:mb-2">
          THE
        </span>
        <h1 class="font-serif font-semibold text-[clamp(1.75rem,8.5vw,5.5rem)] leading-[0.95] tracking-[0.1em] uppercase whitespace-nowrap">
          INDIAN KITCHEN
        </h1>
        <span class="font-sans font-medium text-xs sm:text-sm md:text-base tracking-[0.32em] uppercase text-saffron mt-4 md:mt-6">
          BIRYANI &amp; DOSA
        </span>
      </div>

      <WelcomeGreetings client:load />

      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <a href="/menu" class="btn-arch btn-arch--solid">
          <span class="btn-arch__label">View Menu</span>
        </a>
        <a href="/menu#reserve" class="btn-arch btn-arch--outline">
          <span class="btn-arch__label">Reserve a Table</span>
        </a>
      </div>
    </div>
  </section>

  {/* ABOUT: pattern background, calm premium introduction. */}
  <section id="about" class="bg-cream-pattern text-olive py-24 md:py-32 relative overflow-hidden">
    <div class="container-x text-center max-w-3xl mx-auto relative">
      {/* Faint kolam watermark behind the heading. */}
      <div aria-hidden="true" class="pointer-events-none absolute left-1/2 -top-16 -translate-x-1/2 z-0">
        <Kolam color="var(--saffron)" size="clamp(280px, 44vw, 460px)" opacity={0.07} />
      </div>
      <div class="relative z-10">
        <span class="text-[11px] uppercase tracking-[0.35em] text-saffron">Our Kitchen</span>
        <h2 class="font-serif text-4xl md:text-6xl mt-4 leading-[1.05]">A taste of India, crafted in Toronto.</h2>
        <p class="mt-8 text-lg md:text-xl leading-relaxed text-olive/80">
          The Indian Kitchen is a modern home for the food we grew up on. We slow cook
          Hyderabadi biryani over a low flame, griddle dosa to a deep gold, and pour
          filter coffee the way it is meant to be. Classic recipes, generous hospitality,
          and the warmth of a family table on Yonge Street.
        </p>
        {/* Kolam section divider between About and the marquee. */}
        <div aria-hidden="true" class="mt-14 flex items-center justify-center gap-5">
          <span class="h-px w-16 md:w-24 bg-saffron/40"></span>
          <Kolam color="var(--saffron)" size="46px" opacity={0.9} />
          <span class="h-px w-16 md:w-24 bg-saffron/40"></span>
        </div>
      </div>
    </div>
  </section>

  {/* MARQUEE: moved before Signature Dishes. */}
  <Marquee />

  <SignatureDishesCarousel client:visible />

  <MenuPreview client:visible />

  {/* ORDER: original Lovable Order and Delivery section (cream bracket cards). */}
  <OrderDelivery uberUrl={UBER_EATS_URL} doordashUrl={DOORDASH_URL} pickupUrl={PICKUP_URL} />

  {/* INSTAGRAM: video reels, placed above the reviews. */}
  <InstagramGrid />

  {/* REVIEWS: original Lovable Loved across Toronto section (three static cards). */}
  <ReviewsCarousel />
</BaseLayout>
