---
import BaseLayout from "../layouts/BaseLayout.astro";
import WelcomeGreetings from "../components/WelcomeGreetings.tsx";
import Marquee from "../components/Marquee.astro";
import SignatureDishesCarousel from "../components/SignatureDishesCarousel.tsx";
import MenuPreview from "../components/MenuPreview.tsx";
import InstagramGrid from "../components/InstagramGrid.astro";
import ReviewsCarousel from "../components/ReviewsCarousel.tsx";
import OrderDelivery from "../components/OrderDelivery.tsx";

// ---------------------------------------------------------------------------
// Delivery storefront links. GOES HERE: replace all three with the real URLs.
// Uber Eats and DoorDash open in a new tab. PICKUP_URL is a placeholder that
// may become a phone number (tel:) or an online ordering link later.
// ---------------------------------------------------------------------------
const UBER_EATS_URL = "#"; // PLACEHOLDER
const DOORDASH_URL = "#"; // PLACEHOLDER
const PICKUP_URL = "#"; // PLACEHOLDER

const title = "The Indian Kitchen, Biryani and Dosa | Toronto";
const description =
  "Authentic Hyderabadi biryani and South Indian dosa in Toronto. Modern Indian comfort food, crafted with tradition.";
---

<BaseLayout title={title} description={description}>
  {/* HERO: Full screen layout with a dark green background fallback */}
  <section slot="hero" class="reveal-hero flex items-center justify-center text-center relative overflow-hidden bg-[#121c17] min-h-[85vh] md:min-h-screen w-full">
    
    {/* DESKTOP HERO IMAGE */}
    <img
      src="/hero-home1.png"
      alt=""
      aria-hidden="true"
      class="hidden md:block pointer-events-none select-none absolute inset-x-0 bottom-0 w-full h-full object-cover object-bottom opacity-75"
    />

    {/* MOBILE HERO IMAGE */}
    <img
      src="/hero-home-mobile1.png"
      alt=""
      aria-hidden="true"
      class="block md:hidden pointer-events-none select-none absolute inset-x-0 bottom-0 w-full h-full object-cover object-bottom opacity-95"
    />

    {/* SUBTLE DARK FILTER - Keeps everything integrated nicely */}
    <div aria-hidden="true" class="absolute inset-0 bg-black/10 z-10"></div>

    {/* THE PROBLEM CREAM SCRIM LAYER HAS BEEN COMPLETELY REMOVED FROM HERE */}

    <div class="container-x relative z-20 flex flex-col items-center pt-24 pb-16 my-auto">
      {/* Premium Cream Typography styling */}
      <div class="flex flex-col items-center text-[#e1c7ae] select-none w-full max-w-[92vw] md:max-w-[70vw] drop-shadow-[0_2px_4px_rgba(0,0,0,0.25)]">
        <span class="font-serif text-sm sm:text-base md:text-lg tracking-[0.35em] uppercase mb-1 md:mb-2 font-bold">
          THE
        </span>
        <h1 class="font-serif font-bold text-[clamp(1.75rem,8.5vw,5.5rem)] leading-[0.95] tracking-[0.1em] uppercase whitespace-nowrap drop-shadow-[0_4px_6px_rgba(0,0,0,0.3)]">
          INDIAN KITCHEN
        </h1>
        <span class="font-sans font-bold text-xs sm:text-sm md:text-base tracking-[0.32em] uppercase text-saffron mt-4 md:mt-6 drop-shadow-[0_2px_3px_rgba(0,0,0,0.3)]">
          BIRYANI &amp; DOSA
        </span>
      </div>

      <div class="drop-shadow-[0_2px_4px_rgba(0,0,0,0.3)]">
        <WelcomeGreetings client:load />
      </div>

      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <a href="/menu" class="btn-arch btn-arch--solid">
          <span class="btn-arch__label">View Menu</span>
        </a>
        <a href="/menu#reserve" class="btn-arch btn-arch--outline" style="--btn-outline-fill: #061508;">
          <span class="btn-arch__label">Reserve a Table</span>
        </a>
      </div>
    </div>
  </section>

  {/* ABOUT: pattern background, calm premium introduction. */}
  <section id="about" class="bg-cream-pattern text-olive py-24 md:py-32 relative overflow-hidden">
    <div class="container-x text-center max-w-3xl mx-auto relative">
      <div class="relative z-10">
        <span class="text-[11px] uppercase tracking-[0.35em] text-saffron">Our Kitchen</span>
        <h2 class="font-serif text-4xl md:text-6xl mt-4 leading-[1.05]">A taste of India, crafted in Toronto.</h2>
        <p class="mt-8 text-lg md:text-xl leading-relaxed text-olive/80">
          The Indian Kitchen is a modern home for the food we grew up on. We slow cook
          Hyderabadi biryani over a low flame, griddle dosa to a deep gold, and pour
          filter coffee the way it is meant to be. Classic recipes, generous hospitality,
          and the warmth of a family table on Yonge Street.
        </p>
      </div>
    </div>
  </section>

  {/* MARQUEE: moved before Signature Dishes. */}
  <Marquee />

  <SignatureDishesCarousel client:visible />

  <MenuPreview client:visible />

  {/* ORDER: original Lovable Order and Delivery section (cream bracket cards). */}
  <OrderDelivery uberUrl={UBER_EATS_URL} doordashUrl={DOORDASH_URL} pickupUrl={PICKUP_URL} />

  {/* INSTAGRAM: video reels, placed above the reviews. */}
  <InstagramGrid />

  {/* REVIEWS: original Lovable Loved across Toronto section (three static cards). */}
  <ReviewsCarousel />
</BaseLayout>