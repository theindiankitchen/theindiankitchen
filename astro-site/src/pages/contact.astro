---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import ContactForm from "../components/ContactForm.tsx";

const title = "Contact | The Indian Kitchen, Toronto";
const description =
  "Visit or contact The Indian Kitchen on Yonge Street, North York, Toronto. Reservations, catering enquiries, hours and directions.";

const INSTAGRAM_URL = "https://www.instagram.com/theindiankitchen.ca";
---

<BaseLayout title={title} description={description}>
  {/* HERO: responsive image background with the sticky reveal. */}
  <section slot="hero" class="reveal-hero hero-tint flex items-center justify-center text-center relative overflow-hidden">
    
    {/* DESKTOP HERO IMAGE */}
    <img 
      src="/hero-home1.png" 
      alt="" 
      aria-hidden="true" 
      class="hidden md:block absolute inset-0 size-full object-cover object-center" 
    />

    {/* MOBILE HERO IMAGE: Swaps out on small viewports to prevent unwanted cropping */}
    <img 
      src="/hero-home-mobile2.png" 
      alt="" 
      aria-hidden="true" 
      class="block md:hidden absolute inset-0 size-full object-cover object-center" 
    />

    <div aria-hidden="true" class="img-overlay"></div>

    <div class="container-x relative z-10 max-w-3xl pt-24">
      <span class="inline-block text-[11px] uppercase tracking-[0.45em] text-saffron">Visit and Contact</span>
      <h1 class="font-serif text-4xl sm:text-5xl md:text-7xl mt-6 leading-[1.05]">
        Find us on Yonge Street.
      </h1>
      <p class="mt-6 text-beige/80 text-base md:text-lg max-w-2xl mx-auto leading-relaxed">
        
        
      </p>
    </div>
  </section>

  {/* FORM + MAP */}
  <section class="py-24 md:py-32 bg-cream-pattern text-olive">
    <div class="container-x grid lg:grid-cols-2 gap-10 md:gap-14 items-stretch">
      <div>
        <span class="text-[11px] uppercase tracking-[0.35em] text-saffron">Send a Message</span>
        <h2 class="font-serif text-4xl md:text-5xl mt-4 mb-8 text-olive">Get in touch.</h2>
        <ContactForm client:visible />
      </div>
      <div class="min-h-[420px] lg:min-h-full rounded-[1.6rem] overflow-hidden ring-1 ring-saffron/25">
        <iframe
          title="Map to The Indian Kitchen, 3334 Yonge St, Toronto"
          src="https://www.google.com/maps?q=3334+Yonge+St,+Toronto,+ON+M4N+2M4&output=embed"
          class="w-full h-full min-h-[420px] grayscale-[40%] contrast-[1.05]"
          loading="lazy"
        ></iframe>
      </div>
    </div>
  </section>

  {/* PARALLAX BAND */}
  <section
    aria-label="The Indian Kitchen"
    class="relative h-[55vh] md:h-[70vh] bg-matte"
    style="background-image: linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.4)), url('/assets/hero-spread.jpg'); background-size: cover; background-position: center; background-attachment: fixed;"
  >
    <div class="absolute inset-0 flex items-center justify-center text-center">
      <p class="container-x font-serif text-3xl md:text-5xl text-beige max-w-3xl leading-[1.1]">
        Slow cooked, freshly plated, served with warmth.
      </p>
    </div>
  </section>

  {/* CLOSING: image left, details right */}
  <section class="py-24 md:py-32 bg-cream-pattern text-olive">
    <div class="container-x grid md:grid-cols-2 gap-10 md:gap-14 items-center">
      <div class="relative aspect-[4/3] overflow-hidden rounded-[1.6rem] ring-1 ring-saffron/25">
        <img src="/assets/south-indian.jpg" alt="A South Indian spread at The Indian Kitchen" class="size-full object-cover" />
      </div>
      <div class="text-center md:text-left">
        <span class="text-[11px] uppercase tracking-[0.35em] text-saffron">Details</span>
        <h2 class="font-serif text-4xl md:text-5xl mt-4 text-olive">Come and dine with us.</h2>
        <div class="mt-10 space-y-7 text-olive/85 text-left max-w-xs mx-auto md:mx-0 md:max-w-none">
          <div class="flex gap-4">
            <Icon name="map-pin" class="size-5 text-saffron shrink-0 mt-1" />
            <div class="text-left">
              <div class="text-xs uppercase tracking-[0.2em] text-olive/60">Address</div>
              <p class="mt-1 text-lg">3334 Yonge St<br />North York, Toronto, ON M4N 2M4</p>
            </div>
          </div>
          <div class="flex gap-4">
            <Icon name="clock" class="size-5 text-saffron shrink-0 mt-1" />
            <div class="text-left">
              <div class="text-xs uppercase tracking-[0.2em] text-olive/60">Hours</div>
              <p class="mt-1 text-lg">Mon to Thu, 11:30 AM to 11:00 PM<br />Fri to Sun, 11:30 AM to 1:00 AM</p>
            </div>
          </div>
          <div class="flex gap-4">
            <Icon name="phone" class="size-5 text-saffron shrink-0 mt-1" />
            <div class="text-left">
              <div class="text-xs uppercase tracking-[0.2em] text-olive/60">Phone and Email</div>
              <p class="mt-1 text-lg">
                <a href="tel:+14165550192" class="hover:text-saffron transition-colors">+1 (289) 422-1215</a><br />
                <a href="mailto:hello@theindiankitchen.ca" class="hover:text-saffron transition-colors">hello@theindiankitchen.ca</a>
              </p>
            </div>
          </div>
          <div class="flex gap-4">
            <Icon name="instagram" class="size-5 text-saffron shrink-0 mt-1" />
            <div class="text-left">
              <div class="text-xs uppercase tracking-[0.2em] text-olive/60">Instagram</div>
              <p class="mt-1 text-lg">
                <a href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer external" class="hover:text-saffron transition-colors">@theindiankitchen</a>
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>