---
import BaseLayout from "../layouts/BaseLayout.astro";
import CinematicMenuSection from "../components/CinematicMenuSection.tsx";
import ReservationForm from "../components/ReservationForm.tsx";
import { CATEGORIES } from "../data/menu.ts";

// Jump-to chips and sections both derive from the single CATEGORIES manifest,
// so section order, ids and labels can never drift apart.
const SECTION_NAV: [string, string][] = CATEGORIES.map((c) => [c.label, c.id]);

const title = "Menu, Biryani, Dosa and South Indian | The Indian Kitchen Toronto";
const description =
  "An immersive menu, Hyderabadi dum biryani, Madras dosa, Indo-Chinese, appetizers, curries, drinks and desserts at The Indian Kitchen, Toronto.";
---

<BaseLayout title={title} description={description}>
  {/* HERO: image background with the sticky reveal. */}
  <section slot="hero" class="reveal-hero flex items-center">
    <img src="/assets/menu-dosa-hero.jpg" alt="" aria-hidden="true" class="absolute inset-0 size-full object-cover" />
    <div aria-hidden="true" class="img-overlay"></div>

    <div class="container-x relative z-10 pt-24">
      <div class="max-w-3xl">
        <span class="text-[11px] uppercase tracking-[0.4em] text-saffron">The Indian Kitchen, Toronto</span>
        <h1 class="font-serif text-5xl md:text-7xl mt-5 leading-[1.02] text-beige">
          A cinematic walk<br />through our menu.
        </h1>
        <p class="mt-6 text-beige/75 text-base md:text-lg leading-relaxed max-w-2xl">
          Every plate, slow built the way it should be, from handi biryani sealed over a low
          flame to filter coffee whipped in a steel tumbler.
        </p>
      </div>
    </div>
  </section>

  {/* CUISINE bar: jump-to category chips, first thing after the hero.
      Wraps on every width so all 23 chips stay on screen with no overflow. */}
  <section aria-label="Menu categories" class="bg-cream-pattern text-olive py-6 md:py-8">
    <div class="container-x">
      <div class="flex flex-wrap justify-center items-center gap-2 md:gap-2.5">
        {SECTION_NAV.map(([label, anchor]) => (
          <a href={`#${anchor}`} class="chip-arch chip-arch--idle-cream chip-arch--sm">
            <span class="chip-arch__label">{label}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* One section per category, backgrounds alternating so no two touch. */}
  {CATEGORIES.map((c, i) => (
    <CinematicMenuSection
      client:visible
      variant={i % 2 === 0 ? "cream" : "green"}
      id={c.id}
      kicker={c.kicker}
      title={c.label}
      subtitle={c.subtitle}
      intro={c.intro}
      items={c.items}
    />
  ))}

  {/* Allergy notice: quiet, palette-styled, at the foot of the menu. */}
  <section class="bg-olive text-beige/60 py-8 md:py-10 border-t border-beige/10">
    <div class="container-x">
      <p class="text-xs md:text-sm leading-relaxed max-w-3xl mx-auto text-center">
        If you have any allergies, please let us know before you order. We will do our best to
        help, but please note our kitchen uses all major allergens. Please ask our staff for
        more information.
      </p>
    </div>
  </section>

  {/* RESERVATION: text left, framed form right, on cream. */}
  <section id="reserve" class="py-24 md:py-32 bg-cream-cover text-olive relative overflow-hidden scroll-mt-24">
    <div class="container-x grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div class="text-center lg:text-left">
        <span class="text-[11px] uppercase tracking-[0.4em] text-saffron">Reservations</span>
        <div class="mt-5 flex items-center justify-center lg:justify-start gap-3 text-saffron">
          <span class="h-px w-10 bg-saffron/50"></span>
          <span class="size-2 rotate-45 border border-saffron"></span>
          <span class="h-px w-10 bg-saffron/50"></span>
        </div>
        <h2 class="font-serif text-4xl md:text-6xl mt-6 leading-[1.05] text-olive">Request a Reservation</h2>
        <p class="mt-6 text-olive/75 text-base md:text-lg leading-relaxed max-w-xl mx-auto lg:mx-0">
          Tell us when you would like to join us and how many will be dining. This is a request to
          book, not an instant confirmation. We will confirm your table shortly by phone or email.
        </p>
        <div class="mt-8">
          <a href="/catering" class="btn-arch btn-arch--outline">
            <span class="btn-arch__label">Request Catering</span>
          </a>
        </div>
      </div>

      <ReservationForm client:visible />
    </div>
  </section>
</BaseLayout>
