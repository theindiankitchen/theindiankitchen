---
// Marquee uses the brand display font (Cinzel), loaded globally in BaseLayout,
// so the whole site reads as one voice. Only the font family changed here.

// Brewed-style marquee: two rows scrolling in opposite directions, seamless
// loop. Top row solid cream, bottom row copper outline. A copper period sits
// tight after each dish name, with the full gap after the dot.
const ROW_A = [
  "Hyderabadi Dum Biryani",
  "Masala Dosa",
  "Butter Chicken",
  "Madras Filter Coffee",
  "Ghee Roast Mutton",
  "Pesarattu",
];
const ROW_B = [
  "Nattu Kodi Fry Biryani",
  "Rasmalai",
  "Hyd Chicken 65",
  "Rose Milk",
  "Mysore Masala Dosa",
  "Gulab Jamun",
];
---

<section class="marquee-band relative bg-olive border-y border-saffron/15 overflow-hidden py-[60px] md:py-[100px]" aria-label="A taste of our menu">
  <div class="marquee marquee--left marquee--solid">
    <ul class="marquee__group">
      {ROW_A.map((name) => (
        <li class="marquee__item"><span class="marquee__name">{name}</span><span class="marquee__dot" aria-hidden="true">.</span></li>
      ))}
    </ul>
    <ul class="marquee__group" aria-hidden="true">
      {ROW_A.map((name) => (
        <li class="marquee__item"><span class="marquee__name">{name}</span><span class="marquee__dot" aria-hidden="true">.</span></li>
      ))}
    </ul>
  </div>

  <div class="marquee marquee--right marquee--outline mt-8 md:mt-14">
    <ul class="marquee__group">
      {ROW_B.map((name) => (
        <li class="marquee__item"><span class="marquee__name">{name}</span><span class="marquee__dot" aria-hidden="true">.</span></li>
      ))}
    </ul>
    <ul class="marquee__group" aria-hidden="true">
      {ROW_B.map((name) => (
        <li class="marquee__item"><span class="marquee__name">{name}</span><span class="marquee__dot" aria-hidden="true">.</span></li>
      ))}
    </ul>
  </div>
</section>

<style>
  .marquee {
    display: flex;
    width: max-content;
    will-change: transform;
  }
  .marquee--left {
    animation: marquee-left 48s linear infinite;
  }
  .marquee--right {
    animation: marquee-right 48s linear infinite;
  }
  .marquee-band:hover .marquee {
    animation-play-state: paused;
  }
  .marquee__group {
    display: flex;
    align-items: baseline;
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Name and its trailing period are one unit; the full gap comes after. */
  .marquee__item {
    display: inline-flex;
    align-items: baseline;
    margin-right: 1.75rem;
    white-space: nowrap;
  }
  @media (min-width: 768px) {
    .marquee__item { margin-right: 2.75rem; }
  }
  .marquee__name,
  .marquee__dot {
    font-family: "Cinzel", Georgia, serif;
    font-weight: 500;
    font-size: clamp(1.9rem, 4vw, 5.5rem);
    line-height: 1.1;
  }
  .marquee__name {
    /* Cinzel is a caps titling face; a touch of tracking keeps it even. */
    letter-spacing: 0.01em;
  }
  /* Period sits tight after the last letter, on the baseline, always solid copper. */
  .marquee__dot {
    margin-left: 0.03em;
    color: #b36512;
    -webkit-text-stroke: 0;
    text-stroke: 0;
  }

  /* Top row: solid cream fill, copper period. */
  .marquee--solid .marquee__name {
    color: #e1c7ae;
  }
  /* Bottom row: copper outline, transparent fill, and a solid CREAM period. */
  .marquee--outline .marquee__name {
    color: transparent;
    -webkit-text-stroke: 1.25px #b36512;
    text-stroke: 1.25px #b36512;
  }
  .marquee--outline .marquee__dot {
    color: #e1c7ae;
  }

  @keyframes marquee-left {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @keyframes marquee-right {
    from { transform: translateX(-50%); }
    to { transform: translateX(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee {
      animation: none;
      width: 100%;
      justify-content: center;
      flex-wrap: wrap;
    }
    .marquee__group[aria-hidden="true"] {
      display: none;
    }
  }
</style>
